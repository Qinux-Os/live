[Unit]
Description=Qinux live session
Documentation=man:systemd.special(7)
# Wants, not Requires: a machine with no working network must still reach a
# desktop, because the installer is what fixes the network and the installer is
# reached through the desktop.
Wants=network-online.target
Wants=display-manager.service
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty2.service

[Install]
WantedBy=graphical.target
